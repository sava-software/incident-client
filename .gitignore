.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

.idea
/symlinks/

# Machine-specific agent guidance (see AGENTS.md)
AGENTS.local.md

# Jazzer crash reproducers
crash-*
Crash_*.java

# arcmutate incremental-analysis history (machine-local, written by the hardening plugin)
.pitest-history/
